# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env repoya girmez.
#   cp .env.example .env
#   docker compose up -d --build      → http://localhost:8080

# Veritabanı şifresi (rastgele bir değer: openssl rand -hex 16)
POSTGRES_PASSWORD=

# Access token imza anahtarı, en az 32 karakter (openssl rand -base64 48)
JWT_SIGNING_KEY=

# Arayüzün yayınlanacağı port (varsayılan 8080).
WEB_PORT=8080

# Geliştirme e-posta kutusunun (Mailpit) portu (varsayılan 8025).
MAILPIT_PORT=8025

# Veritabanının dışarıya açılacağı port. Makinede 5432 doluysa değiştirin (varsayılan 5432).
POSTGRES_PORT=5432

# API'yi Docker dışında (dotnet run) çalıştıracaksanız aynı değerleri user-secrets'a yazın:
#   dotnet user-secrets set "ConnectionStrings:Default" \
#     "Host=localhost;Port=<POSTGRES_PORT>;Database=recruitment;Username=recruitment;Password=<sifre>" \
#     --project backend/src/Recruitment.Api
#   dotnet user-secrets set "Jwt:SigningKey" "<anahtar>" --project backend/src/Recruitment.Api
