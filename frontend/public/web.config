<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS yayını için arayüz sitesinin ayarı (nginx.conf'un IIS karşılığı). Vite bu dosyayı dist/ içine
  kopyalar. Docker kurulumunda kullanılmaz, zararı da yoktur.

  Yerleşim: API, bu sitenin altındaki "api" klasöründe, IIS'te "api" adlı UYGULAMA olarak çalışır
  (Add Application: alias "api", API'nin kendi uygulama havuzu). /api/* isteklerini o uygulama karşılar;
  bu dosyadaki kurallar alt uygulamaya geçmesin diye inheritInChildApplications="false" verilmiştir.
  Gereken modül: URL Rewrite. Ayrıntı: docs/IIS-DEPLOYMENT.md
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <!-- Tek sayfa uygulaması: dosya olmayan her yol index.html'e düşer. -->
          <rule name="spa-fallback" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            </conditions>
            <action type="Rewrite" url="/index.html" />
          </rule>
        </rules>
      </rewrite>
      <security>
        <requestFiltering>
          <!-- CV yükleme: uygulama sınırı 10 MB, burada biraz pay bırakılır. -->
          <requestLimits maxAllowedContentLength="12582912" />
        </requestFiltering>
      </security>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Dosya adları içerik hash'i taşır; süresiz önbelleğe alınabilir. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
