<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS'e geçici yayın: sahte kullanıcılarla giriş (LDAP yok). Uygulama Development ortamında
  çalışır; sahte LDAP yalnızca bu ortamda açılabilir. Gerçek AD'ye geçerken bu profil bırakılır.
  Kullanım: dotnet publish backend/src/Recruitment.Api -p:PublishProfile=IIS-Fake
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishDir>..\..\..\publish\api</PublishDir>
    <EnvironmentName>Development</EnvironmentName>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
