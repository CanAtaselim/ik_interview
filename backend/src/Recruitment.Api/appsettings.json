{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=recruitment;Username=recruitment;Password="
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jobs": {
    "Enabled": true
  },
  "Ldap": {
    "Host": "",
    "Port": 389,
    "UseSsl": false,
    "Domain": "",
    "BaseDn": "",
    "BindUser": "",
    "BindPassword": "",
    "UserSearchFilter": "(sAMAccountName={0})",
    "TimeoutSeconds": 10,
    "UseFake": false
  },
  "Jwt": {
    "Issuer": "recruitment-api",
    "Audience": "recruitment-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "IK İşe Alım"
  },
  "Graph": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "OrganizerMailbox": "",
    "UseFake": false,
    "CacheSeconds": 120,
    "TimeoutSeconds": 8
  },
  "FileStorage": {
    "RootPath": "storage",
    "MaxFileSizeMb": 10,
    "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".png", ".jpg", ".jpeg" ],
    "SignedUrlMinutes": 5
  },
  "Recruitment": {
    "CvReviewSlaBusinessDays": 3,
    "CvReviewEscalationBusinessDays": 2,
    "OfferApprovalThreshold": 0,
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{CorrelationId} {Username}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/recruitment-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} <{CorrelationId} {Username}>{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
